# Настройки Health OS. Скопируй этот файл в .env и впиши свои значения.
# Файл .env не попадает в git — ключи не утекут на GitHub.

# Ключ OpenAI: им бот читает анализы и отвечает на вопросы.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini

# Токен Telegram-бота: напиши @BotFather команду /newbot, он пришлёт токен.
TELEGRAM_BOT_TOKEN=

# Страница медкарты в браузере: порт и пароль (логин можно вводить любой).
WEB_PORT=8080
WEB_PASSWORD=
# Адрес страницы, который бот присылает после разбора анализа, например http://1.2.3.4:8080
PUBLIC_URL=

# Напоминания: во сколько бот проверяет сроки и за сколько дней предупреждает.
REMIND_HOUR=9
REMIND_DAYS_AHEAD=14
